export type OsmPoint = { x: number, y: number }
export type OsmAreaPolygon = {
	id: number,
	kind: string,
	points: { OsmPoint },
	-- KC-472: только kind = "parking"
	parkingKind: string?,
	capacity: number?,
	-- KC-472: только kind = "pitch"
	sport: string?,
}
export type OsmAreaLine = { id: number, kind: string, points: { OsmPoint } }
export type OsmAreaPoint = {
	id: number,
	kind: string,
	x: number,
	y: number,
	-- KC-472: GateKinds для kind = "gate", EquipmentKinds для kind = "equipment"
	detail: string?,
}

export type OsmAreasData = {
	Kinds: { string },
	GateKinds: { string },
	ParkingKinds: { string },
	EquipmentKinds: { string },
	SportKinds: { string },
	Polygons: { OsmAreaPolygon },
	Lines: { OsmAreaLine },
